# Copia como referencia y configura estas variables en Dokploy → Environment

# --- Obligatorias en producción ---
DJANGO_SECRET_KEY=genera-un-secreto-largo-y-aleatorio
POSTGRES_PASSWORD=password-seguro-de-postgres

# URL pública (sin barra final). Incluye puerto si no es el 80.
# Con dominio:  https://villanueva.tudominio.com
# Solo con IP:  http://123.45.67.89:8080
PUBLIC_SITE_URL=

# Hosts permitidos por Django (separados por coma)
# Con IP: 123.45.67.89
ALLOWED_HOSTS=123.45.67.89,localhost

# Puerto publicado de nginx en el VPS (debe coincidir con PUBLIC_SITE_URL)
NGINX_PUBLISH=8080

# Ruta absoluta a media en el VPS (recomendado en Dokploy)
# MEDIA_HOST_PATH=/etc/dokploy/compose/TU-APP/code/media_volume

# Solo true si usas HTTPS (dominio + certificado). Con IP suele ser false.
USE_HTTPS=false

# --- Base de datos ---
POSTGRES_DB=villanueva_db
POSTGRES_USER=postgres

# --- Django ---
DEBUG=0

# --- Frontend (dejar vacío si nginx y API comparten el mismo dominio) ---
VITE_API_BASE_URL=
VITE_IMAGE_IP=

# --- Opcional ---
GUNICORN_WORKERS=2
